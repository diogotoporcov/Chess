<UserControl x:Class="Chess.Desktop.Views.Components.GameInfoPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <TextBlock Text="Mode"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   TextOptions.TextFormattingMode="Display" />

        <TextBlock Text="{Binding ModeName}"
                   Margin="0,5,0,0"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18"
                   TextWrapping="Wrap" />

        <Border Height="1"
                Margin="0,20,0,20"
                Background="{StaticResource SurfaceBorderBrush}" />

        <TextBlock Text="Turn"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   FontWeight="SemiBold" />

        <TextBlock Text="{Binding CurrentTurn}"
                   Margin="0,5,0,22"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18" />

        <TextBlock Text="Status"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   FontWeight="SemiBold" />

        <TextBlock Text="{Binding Status}"
                   Margin="0,5,0,0"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="17"
                   TextWrapping="Wrap" />

    </StackPanel>

</UserControl>
